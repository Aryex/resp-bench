{
    "schema_version": "1.0",
    "benchmark_profile": {
        "name": "GLIDE Stability Test - 30s Cluster",
        "description": "Quick cluster stability test: warmup then 30s sustained mixed workload"
    },
    "phases": [
        {
            "id": "WARMUP",
            "description": "Populate 1M keys with sequential SET operations",
            "connections": 10,
            "completion": {"type": "requests", "requests": 1000000},
            "keyspace": {
                "keys_count": 1000000,
                "key_prefix": "bench:",
                "generation_alg": "sequential_int"
            },
            "commands": [
                {"command": "set", "weight": 1.0, "data_size_bytes": 512}
            ]
        },
        {
            "id": "STEADY",
            "description": "30s sustained 80/20 GET/SET workload",
            "connections": 10,
            "completion": {"type": "duration", "seconds": 30},
            "interval_histogram_seconds": 30,
            "keyspace": {
                "keys_count": 1000000,
                "key_prefix": "bench:",
                "generation_alg": "uniform_rand"
            },
            "commands": [
                {"command": "get", "weight": 0.8},
                {"command": "set", "weight": 0.2, "data_size_bytes": 512}
            ]
        }
    ]
}
