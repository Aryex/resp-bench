{
    "schema_version": "1.0",
    "benchmark_profile": {
        "name": "PHP GLIDE Stability Test - 24 hours",
        "description": "24-hour sustained mixed workload with 30s interval histograms"
    },
    "phases": [
        {
            "id": "WARMUP",
            "connections": 10,
            "completion": { "type": "requests", "requests": 1000000 },
            "keyspace": {
                "keys_count": 1000000,
                "key_prefix": "stability:",
                "generation_alg": "sequential_int"
            },
            "commands": [
                { "command": "set", "weight": 1.0, "data_size_bytes": 512 }
            ]
        },
        {
            "id": "STEADY",
            "connections": 10,
            "interval_histogram_seconds": 30,
            "completion": { "type": "duration", "seconds": 86400 },
            "keyspace": {
                "keys_count": 1000000,
                "key_prefix": "stability:",
                "generation_alg": "uniform_rand"
            },
            "commands": [
                { "command": "get", "weight": 0.8 },
                { "command": "set", "weight": 0.2, "data_size_bytes": 512 }
            ]
        }
    ]
}
