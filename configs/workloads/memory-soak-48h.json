{
    "schema_version": "1.0",
    "benchmark_profile": {
        "name": "Memory Stability Test - 48h sustained single client",
        "description": "Long-duration soak test for confirming memory leak fix. 48h duration, single connection.",
        "version": "1.0.0"
    },
    "phases": [
        {
            "id": "WARMUP",
            "description": "Populate 10K keys",
            "connections": 1,
            "cps_limit": -1,
            "rps_limit": -1,
            "completion": {
                "type": "requests",
                "requests": 10000
            },
            "keyspace": {
                "keys_count": 10000,
                "key_size_bytes": 16,
                "key_prefix": "soak:",
                "generation_alg": "sequential_int"
            },
            "commands": [
                {
                    "command": "set",
                    "weight": 1.0,
                    "data_size_bytes": 512
                }
            ]
        },
        {
            "id": "STEADY",
            "description": "48h sustained workload for memory stability validation",
            "connections": 1,
            "cps_limit": -1,
            "rps_limit": -1,
            "completion": {
                "type": "duration",
                "seconds": 172800
            },
            "keyspace": {
                "keys_count": 10000,
                "key_size_bytes": 16,
                "key_prefix": "soak:",
                "generation_alg": "uniform_rand",
                "seed": 12345
            },
            "commands": [
                {
                    "command": "get",
                    "weight": 0.8
                },
                {
                    "command": "set",
                    "weight": 0.2,
                    "data_size_bytes": 512
                }
            ]
        }
    ]
}
