{
    "schema_version": "1.0",
    "benchmark_profile": {
        "name": "GLIDE Stability Test - 20min Shared Client",
        "description": "Stability test: 10 workers sharing 1 Glide client, 80/20 GET/SET"
    },
    "phases": [
        {
            "id": "WARMUP",
            "description": "Populate 1M keys with sequential SET operations",
            "connections": 10,
            "shared_client": true,
            "completion": {"type": "requests", "requests": 1000000},
            "keyspace": {
                "keys_count": 1000000,
                "key_prefix": "stability:",
                "generation_alg": "sequential_int"
            },
            "commands": [
                {"command": "set", "weight": 1.0, "data_size_bytes": 512}
            ]
        },
        {
            "id": "STEADY",
            "description": "20min sustained 80/20 GET/SET, 10 workers sharing 1 client",
            "connections": 10,
            "shared_client": true,
            "completion": {"type": "duration", "seconds": 1200},
            "interval_histogram_seconds": 30,
            "keyspace": {
                "keys_count": 1000000,
                "key_prefix": "stability:",
                "generation_alg": "uniform_rand"
            },
            "commands": [
                {"command": "get", "weight": 0.8},
                {"command": "set", "weight": 0.2, "data_size_bytes": 512}
            ]
        }
    ]
}
