{
    "schema_version": "1.0",
    "benchmark_profile": {
        "name": "Interval Histogram Test",
        "description": "Short 30s workload to verify interval histogram logging"
    },
    "phases": [
        {
            "id": "WARMUP",
            "description": "Populate keys",
            "connections": 5,
            "completion": {"type": "requests", "requests": 10000},
            "keyspace": {
                "keys_count": 10000,
                "key_prefix": "test:",
                "generation_alg": "sequential_int"
            },
            "commands": [
                {"command": "set", "weight": 1.0, "data_size_bytes": 256}
            ]
        },
        {
            "id": "STEADY",
            "description": "30s mixed workload with 1s interval histograms",
            "connections": 5,
            "completion": {"type": "duration", "seconds": 30},
            "interval_histogram_seconds": 1,
            "keyspace": {
                "keys_count": 10000,
                "key_prefix": "test:",
                "generation_alg": "uniform_rand"
            },
            "commands": [
                {"command": "get", "weight": 0.8},
                {"command": "set", "weight": 0.2, "data_size_bytes": 256}
            ]
        }
    ]
}
