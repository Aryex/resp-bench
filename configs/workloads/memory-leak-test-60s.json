{
    "schema_version": "1.0",
    "benchmark_profile": {
        "name": "Memory Leak Test - 60s sustained single client",
        "description": "Long steady-state run for detecting memory leaks. 60s duration, single connection.",
        "version": "1.0.0"
    },
    "phases": [
        {
            "id": "WARMUP",
            "description": "Minimal warmup - populate 1000 keys",
            "connections": 1,
            "cps_limit": -1,
            "rps_limit": -1,
            "completion": {
                "type": "requests",
                "requests": 1000
            },
            "keyspace": {
                "keys_count": 1000,
                "key_size_bytes": 16,
                "key_prefix": "leak:",
                "generation_alg": "sequential_int"
            },
            "commands": [
                {
                    "command": "set",
                    "weight": 1.0,
                    "data_size_bytes": 512
                }
            ]
        },
        {
            "id": "STEADY",
            "description": "Sustained 60s workload for memory leak detection",
            "connections": 1,
            "cps_limit": -1,
            "rps_limit": -1,
            "completion": {
                "type": "duration",
                "seconds": 60
            },
            "keyspace": {
                "keys_count": 1000,
                "key_size_bytes": 16,
                "key_prefix": "leak:",
                "generation_alg": "uniform_rand",
                "seed": 12345
            },
            "commands": [
                {
                    "command": "get",
                    "weight": 0.8
                },
                {
                    "command": "set",
                    "weight": 0.2,
                    "data_size_bytes": 512
                }
            ]
        }
    ]
}
